# === Client-side (browser) — publishable key only (whpk_…) ===
NEXT_PUBLIC_WHISTLE_PUBLISHABLE_KEY=whpk_replace_me
NEXT_PUBLIC_WHISTLE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# API base URL for the embed iframe. Default: http://localhost:3001/sdk/whistle/v1
# NEXT_PUBLIC_WHISTLE_API_BASE=http://localhost:3001/sdk/whistle/v1

# === Server-side (API route handler) — secret key (wh_…) ===
# Used by app/api/whistle/report/route.ts to forward reports to the Whistle API.
# The browser never sees this key.
WHISTLE_API_KEY=wh_replace_me
WHISTLE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Override the default Whistle API URL (for local dev against the Elysia server)
# WHISTLE_API_URL=http://localhost:3001/sdk/whistle/v1
